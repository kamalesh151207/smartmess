# Copy this file to .env and fill in your actual values
# Never commit the real .env file

# --- Server ---
PORT=3001
NODE_ENV=development

# --- CORS ---
# Set this to your deployed Netlify frontend URL in production
# Example: https://smartmess.netlify.app
FRONTEND_URL=http://localhost:5173

# --- Database ---
# SQLite is used by default (local file at server/smart_mess.db)
# If migrating to PostgreSQL, uncomment and fill in:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# --- Python ML Service ---
# URL of the deployed Python FastAPI inference service
# Example: https://smartmess-ml.onrender.com
ML_SERVICE_URL=http://localhost:8000
